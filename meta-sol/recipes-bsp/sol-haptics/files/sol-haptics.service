[Unit]
Description=sol: load the CS40L26 haptic driver (after the firmware path is set)
# ORDERING IS LOAD-BEARING, NOT COSMETIC.
#
# cs40l26 loads its DSP firmware with SYNCHRONOUS request_firmware() (cs40l26.c
# :4649/:4651/:4914 -- NOT request_firmware_nowait), so probe FAILS outright if
# the firmware cannot be found at that moment. The files (cs40l26.wmfw,
# cs40l26.bin, cs40l26-svc.bin, cs40l26-calib.*) live in the Android vendor
# image, and sol-adsp-boot is what points
# /sys/module/firmware_class/parameters/path at /android/vendor/firmware.
#
# That is also why this is NOT in sol-post-rootfs.conf: systemd-modules-load
# runs early, well before sol-adsp-boot, and the probe would lose the race and
# fail permanently. Keeping it out of that list is necessary but NOT
# sufficient -- udev autoloads the module by modalias too, ~3s earlier still,
# so sol-cs40l26-blacklist.conf suppresses that and leaves this the only
# loader.
#
# The firmware itself lives on the Android vendor mount, so depend on the
# mount directly rather than only on adsp-boot: RequiresMountsFor implies
# Requires= and After= on the mount unit.
After=sol-adsp-boot.service
Requires=sol-adsp-boot.service
RequiresMountsFor=/android/vendor/firmware

[Service]
Type=oneshot
RemainAfterExit=yes
# input-cs40l26-i2c pulls cl_dsp and the codec in via modules.dep.
ExecStart=/sbin/modprobe input-cs40l26-i2c
# Report what we got, so a failed firmware load is visible in the journal
# rather than showing up later as "the vibrator does nothing".
ExecStartPost=/bin/sh -c 'd=/sys/bus/i2c/devices/0-0043; if [ -e "$d/driver" ]; then echo "sol-haptics: bound to $(basename $(readlink $d/driver))"; else echo "sol-haptics: 0-0043 present but unbound; see dmesg for the probe error"; fi; for e in /dev/input/event*; do [ "$(cat /sys/class/input/$(basename $e)/device/name 2>/dev/null)" = cs40l26_input ] && echo "sol-haptics: force-feedback node $e"; done'

[Install]
WantedBy=multi-user.target
